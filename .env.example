# Copy to .env and fill in. .env is git-ignored — never commit it.

# Where the data comes from:
#   api — the live API's GET /api/admin/report (default; no database access needed)
#   sql — ceustampsdb directly, with the read-only report login
REPORT_SOURCE=api

# --- api ---------------------------------------------------------------------
# The key is the ceustamps-api Web App's CEU_ADMIN_KEY. It stays on this server;
# the browser never sees it. https is required.
REPORT_API_URL=https://ceustamps-api.azurewebsites.net
REPORT_API_KEY=

# --- sql (only when REPORT_SOURCE=sql; docs/report-requirements.md §2) --------
# Use the read-only report login, never ceustamps_app or tradealgoadmin — the
# app refuses to start with either.
REPORT_SQL_SERVER=tradealgo-sql8892.database.windows.net
REPORT_SQL_PORT=1433
REPORT_SQL_DATABASE=ceustampsdb
REPORT_SQL_USER=ceustamps_report
REPORT_SQL_PASSWORD=

# --- who can open the report ---------------------------------------------------
# The default (loopback) means only this machine can open it, and requests that
# came through a proxy are refused.
REPORT_HOST=127.0.0.1
REPORT_PORT=5180

# Required whenever REPORT_HOST is not a loopback address (e.g. 0.0.0.0 on a
# hosted server). Browsers will ask for these. Serve it over HTTPS only.
REPORT_AUTH_USER=
REPORT_AUTH_PASSWORD=
